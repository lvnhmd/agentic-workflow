# Preset: Node.js / TypeScript (npm scripts, Prettier, ESLint)
FORMAT_FILE_CMD="npx --no-install prettier --write"
FORMAT_FILE_REGEX='\.(ts|tsx|js|jsx|mjs|cjs|json|md|css|scss|yml|yaml|html)$'
LINT_FIX_FILE_CMD="npx --no-install eslint --fix --no-warn-ignored"
LINT_FIX_FILE_REGEX='\.(ts|tsx|js|jsx|mjs|cjs)$'
DEV_CMD="npm run dev"
APP_URL="http://localhost:3000"
VERIFY_STEPS='fast | Format check | npm run format:check --if-present
fast | Lint | npm run lint --if-present
fast | Typecheck | npm run typecheck --if-present
fast | Unit tests | npm test --if-present
full | Integration tests | npm run test:integration --if-present
full | Build | npm run build --if-present
full | Dependency audit | npm audit --audit-level=high'
