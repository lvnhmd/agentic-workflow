# Preset: Python (ruff, mypy, pytest)
FORMAT_FILE_CMD="ruff format"
FORMAT_FILE_REGEX='\.py$'
LINT_FIX_FILE_CMD="ruff check --fix"
LINT_FIX_FILE_REGEX='\.py$'
DEV_CMD=""
APP_URL="http://localhost:8000"
VERIFY_STEPS='fast | Format check | ruff format --check .
fast | Lint | ruff check .
fast | Typecheck | mypy .
fast | Unit tests | pytest -q
full | Dependency audit | pip-audit'
