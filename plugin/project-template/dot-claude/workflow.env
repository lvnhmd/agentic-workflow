# Agentic workflow configuration — committed, shared by the team, NO SECRETS.
# Secrets (tokens, emails, account IDs) go in the developer-local .env (see .env.workflow.example).
# Every command, hook and script under .claude/ and scripts/agentic/ reads this file at runtime,
# so changing a value here changes behaviour everywhere without editing the commands.

# --- Project -----------------------------------------------------------------
PROJECT_NAME="{{PROJECT_NAME}}"
# GitHub "owner/repo" — used by gh and the CI adapter.
REPO_SLUG="{{REPO_SLUG}}"
DEFAULT_BRANCH="{{DEFAULT_BRANCH}}"
# Regex of branches nobody (human or agent) commits or force-pushes to directly.
PROTECTED_BRANCHES="^(main|master|staging|production)$"

# --- Ticket tracker -------------------------------------------------------------
# jira   — Jira Cloud via REST (needs JIRA_* in .env)
# github — GitHub Issues via gh (no extra credentials)
TRACKER="{{TRACKER}}"
# Jira project key, e.g. ABC. Bare numbers typed into commands get this prefix.
# Ignored for TRACKER=github (issue numbers are used as-is).
TICKET_PREFIX="{{TICKET_PREFIX}}"
# Optional Jira board ID: picked-up / captured tickets are moved onto it. Leave empty to skip.
JIRA_BOARD_ID=""
# Status names as they appear in your tracker. For TRACKER=github these become
# "status:<slugified-name>" labels, except STATUS_DONE which closes the issue.
STATUS_IN_PROGRESS="In Progress"
STATUS_REVIEW="Review"
STATUS_QA="Ready for Testing"
STATUS_DONE="Done"

# --- CI ----------------------------------------------------------------------
# github   — GitHub Actions via gh
# circleci — CircleCI REST v2 (needs CIRCLECI_TOKEN in .env)
# none     — no CI adapter; /fix-ci and /nightly-check will say so and stop
CI_PROVIDER="{{CI_PROVIDER}}"

# --- Formatting on every agent edit (PostToolUse hook) -------------------------------
# Command run on each file Claude writes or edits, if the file matches the regex.
# Leave a command empty to disable it.
FORMAT_FILE_CMD="{{FORMAT_FILE_CMD}}"
FORMAT_FILE_REGEX="{{FORMAT_FILE_REGEX}}"
LINT_FIX_FILE_CMD="{{LINT_FIX_FILE_CMD}}"
LINT_FIX_FILE_REGEX="{{LINT_FIX_FILE_REGEX}}"

# --- Local app (used by the run skill and Playwright verification) ---------------------
DEV_CMD="{{DEV_CMD}}"
APP_URL="{{APP_URL}}"
# URL that returns any HTTP status once the app is up. Empty = use APP_URL.
HEALTH_URL=""
# Names of the .env variables holding a test login, if the app needs one. Leave empty if not.
TEST_USER_VAR=""
TEST_PASSWORD_VAR=""

# --- Deployed configuration -------------------------------------------------------
# Where runtime env vars live in deployed environments (a config repo, a secrets manager,
# CI project settings...). When an .env.example changes, the agent is reminded to update it.
# Leave empty to only get a generic reminder.
DEPLOY_CONFIG_NOTE=""

# --- Attribution -------------------------------------------------------------
# Appended to every comment, reply or ticket update the agent posts to an external system.
ATTRIBUTION="_Actioned by Claude Code_"
